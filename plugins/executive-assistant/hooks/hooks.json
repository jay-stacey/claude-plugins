{
  "description": "Opt-in day-plan anchor at the start of a new Claude session",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session_context.py",
              "--vault",
              "${user_config.notes_vault_path}",
              "--enabled",
              "${user_config.session_context}"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
