{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "assistant|email-assistant|calendar-assistant|task-assistant|initializer",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/tts-speak.py"
            ],
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
