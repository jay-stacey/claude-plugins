{
  "_comment": "Executive Assistant Plugin Configuration v5.0.0",
  "_description": "Highly configurable executive assistant for productivity workflow automation. Uses Google Workspace MCP for Gmail and Calendar.",
  "mcpServer": {
    "_comment": "Google Workspace MCP server configuration. Set GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET environment variables. Server is bundled via .mcp.json.",
    "serverName": "google-workspace",
    "timezone": "America/Toronto",
    "gmail": {
      "maxResults": 100
    },
    "calendar": {
      "calendarId": "primary"
    }
  },
  "features": {
    "gmail": {
      "enabled": true
    },
    "googleCalendar": {
      "enabled": true
    },
    "slack": {
      "enabled": false
    },
    "jira": {
      "enabled": true
    },
    "linear": {
      "enabled": false
    },
    "notes": {
      "enabled": true
    }
  },
  "personality": {
    "_comment": "To use a personality preset, set preset: 'warm'. See config/presets/ for available presets.",
    "preset": null,
    "name": "Assistant",
    "style": "professional",
    "useEmojis": true,
    "celebrateWins": false,
    "humorLevel": "light",
    "greetingStyle": "time-aware",
    "professionalForExternal": true,
    "customGreetings": {
      "morning": "Good morning! Ready to tackle the day?",
      "afternoon": "Good afternoon! Let's make progress.",
      "evening": "Good evening! Wrapping up for today?"
    },
    "responseStyle": "conversational",
    "adhdFriendly": {
      "enabled": true,
      "leadWithSummaries": true,
      "plainLanguage": true,
      "bulletQuietItems": true,
      "maxUrgentItems": 5,
      "maxChoices": 2,
      "avoidTables": true
    }
  },
  "user": {
    "name": "",
    "nickname": "",
    "role": "",
    "timezone": "America/Toronto",
    "workingHours": {
      "start": "06:30",
      "end": "15:00"
    },
    "accessibilityPreferences": [],
    "vipContacts": []
  },
  "gmail": {
    "enabled": true,
    "scanMode": "unread",
    "scanHours": 24,
    "unreadOnly": true,
    "maxEmails": 100,
    "skipLabels": [
      "Promotions",
      "Social",
      "Updates"
    ],
    "urgentKeywords": [
      "urgent",
      "asap",
      "deadline",
      "today",
      "critical"
    ],
    "importantKeywords": [
      "feature",
      "bug",
      "review",
      "question"
    ],
    "whitelist": {
      "domains": [],
      "senders": []
    },
    "blacklist": {
      "domains": [],
      "senders": [],
      "subjectPatterns": []
    },
    "newsletters": {
      "enabled": true,
      "tldrSources": [
        "TLDR",
        "TLDR AI",
        "TLDR Web Dev",
        "TLDR DevOps",
        "TLDR Founders"
      ],
      "senderPatterns": [
        "@tldr.tech",
        "@tldrnewsletter.com"
      ],
      "topicFilters": [
        "AI/ML",
        "LLMs",
        "Web Development",
        "Full-Stack",
        "DevOps",
        "Cloud",
        "Business/CTO",
        "Leadership"
      ],
      "maxArticlesPerDay": 3,
      "requireApprovalBeforeAdding": true
    },
    "cleanup": {
      "enabled": true,
      "batchApprovalRequired": true,
      "autoArchive": {
        "enabled": false,
        "afterDays": 7,
        "categories": [
          "notifications",
          "automated"
        ]
      },
      "categories": {
        "informational": {
          "enabled": true,
          "action": "archive",
          "addSummaryToDaily": true,
          "senderPatterns": [
            "no-reply@",
            "noreply@",
            "notifications@",
            "updates@"
          ],
          "subjectPatterns": [
            "FYI",
            "update",
            "status",
            "report",
            "weekly"
          ]
        },
        "marketing": {
          "enabled": true,
          "action": "delete",
          "attemptUnsubscribe": true,
          "subjectPatterns": [
            "promo",
            "deal",
            "offer",
            "sale",
            "discount",
            "% off",
            "limited time"
          ]
        },
        "azureAlerts": {
          "enabled": true,
          "action": "archive",
          "addSummaryToDaily": true,
          "senderPatterns": [
            "azure-noreply@microsoft.com",
            "azurealerts@microsoft.com",
            "microsoft-noreply@microsoft.com"
          ]
        },
        "githubNotifications": {
          "enabled": true,
          "action": "archive",
          "addSummaryToDaily": true,
          "senderPatterns": [
            "notifications@github.com"
          ]
        },
        "jiraNotifications": {
          "enabled": true,
          "action": "conditional",
          "deleteFieldChangesOnly": true,
          "keepIfMentionOrQuestion": true,
          "senderPatterns": [
            "jira@",
            "@atlassian.net",
            "atlassian.com"
          ]
        }
      }
    }
  },
  "calendar": {
    "enabled": true,
    "_comment": "Fallbacks only. The profile at {vault}/assistant/profile.md wins, then /plugin configure values.",
    "workingHours": {
      "start": "06:30",
      "end": "15:00"
    },
    "workdays": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday"
    ],
    "timezone": "America/Toronto",
    "reviewDays": 5,
    "includeCalendars": [],
    "minFreeBlockMinutes": 25,
    "energyPatterns": {
      "deep": {
        "start": "06:30",
        "end": "11:30"
      },
      "collab": {
        "start": "11:30",
        "end": "13:30"
      },
      "admin": {
        "start": "13:30",
        "end": "15:00"
      }
    },
    "breaks": {
      "enabled": true,
      "minBufferMinutes": 10,
      "lunchBreak": {
        "start": "11:30",
        "duration": 30,
        "window": "11:00-13:30"
      },
      "enforceBufferBetweenMeetings": true
    },
    "eventFiltering": {
      "hideDeclined": true,
      "hideCancelled": true,
      "ownEventsOnly": true
    },
    "flags": {
      "heavyDayMeetingHours": 5,
      "minDeepFreeMinutes": 60,
      "backToBackHours": 2,
      "maxPrepTasks": 5
    },
    "timeboxing": {
      "enabled": true,
      "maxUtilization": 0.75,
      "bufferMinutes": 10,
      "maxBlockMinutes": 120,
      "roundToMinutes": 5,
      "defaultEstimateMinutes": 30,
      "preferredFocusTime": "morning"
    },
    "focusBlock": {
      "titlePrefix": "[Focus]",
      "marker": "ea:focus",
      "descriptionFirstLine": "ea:focus · created by executive-assistant",
      "transparency": "opaque"
    }
  },
  "slack": {
    "enabled": false,
    "apiMode": true,
    "workspaceUrl": "",
    "scanHours": 24,
    "unreadOnly": true,
    "includeChannels": [],
    "excludeChannels": [
      "random",
      "watercooler",
      "social"
    ],
    "prioritizeDMs": true,
    "prioritizeMentions": true
  },
  "jira": {
    "enabled": true,
    "cloudId": "",
    "activeSprintOnly": true,
    "includedProjects": [],
    "priorityThreshold": "Medium",
    "checkComments": true,
    "commentHoursThreshold": 24,
    "mentions": {
      "enabled": true,
      "includeResolved": false,
      "maxAgeDays": 7,
      "maxResults": 25
    }
  },
  "linear": {
    "enabled": false,
    "teams": [],
    "activeSprintOnly": true,
    "priorityThreshold": "Medium",
    "includeArchived": false,
    "mentions": {
      "enabled": true,
      "maxAgeDays": 7
    }
  },
  "outlook": {
    "enabled": false,
    "_status": "coming_soon",
    "_description": "Microsoft Outlook integration (coming in future release). Requires Microsoft Graph API MCP server.",
    "email": {
      "scanHours": 24,
      "folders": [
        "Inbox",
        "Important"
      ],
      "unreadOnly": true,
      "maxEmails": 100
    },
    "calendar": {
      "enabled": false,
      "includeCategories": [],
      "excludeCategories": []
    },
    "whitelist": {
      "domains": [],
      "senders": []
    },
    "blacklist": {
      "domains": [],
      "senders": [],
      "subjectPatterns": []
    }
  },
  "teams": {
    "enabled": false,
    "_status": "coming_soon",
    "_description": "Microsoft Teams integration (coming in future release). Requires Microsoft Graph API MCP server.",
    "channels": [],
    "prioritizeMentions": true,
    "prioritizeDMs": true,
    "scanHours": 24,
    "excludeChannels": []
  },
  "notes": {
    "enabled": true,
    "vaultPath": "",
    "dailyFolder": "Daily Notes",
    "dateFormat": "YYYY-MM-DD",
    "templatePath": "Templates/Daily Note.md"
  },
  "memory": {
    "enabled": true,
    "readingPreferencesPath": "Memory/reading-preferences.md",
    "retentionDays": 30,
    "minDataForLearning": 5
  },
  "categorization": {
    "urgentPriorities": [
      "Critical",
      "Highest"
    ],
    "importantPriorities": [
      "High",
      "Medium"
    ],
    "dueTodayIsUrgent": true,
    "dueTomorrowIsUrgent": true,
    "dueThisWeekIsImportant": true
  },
  "dayPlanning": {
    "enabled": true,
    "autoSuggestTimeBlocks": true,
    "requireApprovalForEvents": true,
    "maxSchedulePercent": 75,
    "bufferMinutes": 10,
    "focusBlockPrefix": "[Focus]",
    "taskDurationEstimates": {
      "emailResponse": 15,
      "slackFollowup": 15,
      "codeReview": 45,
      "jiraBug": 90,
      "jiraFeature": 180,
      "meeting": 60
    }
  },
  "automation": {
    "autoRunOnSessionStart": false,
    "confirmBeforeWrite": true,
    "createDailyNoteIfMissing": true,
    "addTimestampToSummary": true,
    "showPreviewBeforeConsolidation": true
  },
  "output": {
    "includeSourceLinks": true,
    "useEmojis": false,
    "groupByPriority": true,
    "showSummaryStatistics": false,
    "maxTasksPerSection": 50
  },
  "gmailOrganizer": {
    "enabled": true,
    "autoCreateLabels": true,
    "labelHierarchy": {
      "Action": [
        "Urgent",
        "This Week"
      ],
      "FYI": [
        "Read Later",
        "Newsletters",
        "Reports"
      ],
      "Monitoring": [
        "Azure",
        "Critical",
        "Warning"
      ],
      "Development": [
        "GitHub",
        "Code Review"
      ],
      "Work": [
        "Jira",
        "High Priority",
        "Medium Priority",
        "Low Priority"
      ],
      "Projects": []
    },
    "urgentKeepInInbox": true,
    "starUrgentEmails": true,
    "archiveAfterLabeling": true,
    "batchSize": 50,
    "useKeyboardShortcuts": true
  },
  "inboxZero": {
    "enabled": true,
    "runWithDailyPrep": true,
    "scanMode": "unread",
    "processNewsletters": true,
    "runCleanup": true,
    "applyLabels": true,
    "archiveProcessed": true,
    "keepUrgentInInbox": true,
    "starUrgentEmails": true,
    "batchSize": 50,
    "requireApproval": true
  },
  "safety": {
    "neverDeleteEmailsPermanently": true,
    "neverDeleteSlackMessages": true,
    "neverUpdateJiraAutomatically": true,
    "neverUpdateLinearAutomatically": true,
    "requireConfirmationForVaultWrite": true,
    "createBackupBeforeMajorChanges": true,
    "neverCreateCalendarEventsWithoutApproval": true,
    "neverModifyExistingCalendarEvents": true,
    "neverAcceptDeclineMeetings": true,
    "batchApprovalForEmailActions": true
  }
}
