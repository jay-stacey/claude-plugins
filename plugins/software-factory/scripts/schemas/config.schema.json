{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.local/schemas/config.schema.json",
  "title": "Factory config",
  "description": ".factory/config.json (contracts 3, 12.3, 14.5). Unknown keys are kept.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "existing",
            "new"
          ]
        },
        "default_branch": {
          "type": "string"
        },
        "remote": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "repo": {
              "type": "string"
            }
          }
        }
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "object",
      "properties": {
        "install": {
          "type": [
            "string",
            "null"
          ]
        },
        "build": {
          "type": [
            "string",
            "null"
          ]
        },
        "test": {
          "type": [
            "string",
            "null"
          ]
        },
        "lint": {
          "type": [
            "string",
            "null"
          ]
        },
        "typecheck": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        },
        "e2e": {
          "type": [
            "string",
            "null"
          ]
        },
        "migrate_up": {
          "type": [
            "string",
            "null"
          ]
        },
        "migrate_down": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "enum": [
              "cto",
              "product-manager",
              "project-manager",
              "staff-engineer",
              "ui-ux-designer",
              "data-engineer",
              "backend-engineer",
              "frontend-engineer",
              "devops-release",
              "qa-engineer",
              "code-reviewer",
              "security-reviewer",
              "critic",
              "tech-writer"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "patternProperties": {
        "^G[1-4]$": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "approvers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "tier_defaults": {
          "type": "object",
          "properties": {
            "S": {
              "type": "number"
            },
            "M": {
              "type": "number"
            },
            "L": {
              "type": "number"
            }
          }
        },
        "warn_pct": {
          "type": "number"
        },
        "stop_pct": {
          "type": "number"
        },
        "weights": {
          "type": "object",
          "properties": {
            "input": {
              "type": "number"
            },
            "output": {
              "type": "number"
            },
            "cache_creation": {
              "type": "number"
            },
            "cache_read": {
              "type": "number"
            }
          }
        },
        "estimates": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Includes assess, report, cycle_plan and triage (§21.8)."
        },
        "hard_kill": {
          "type": "boolean"
        }
      }
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "builders": {
          "type": "integer"
        },
        "reviewers": {
          "type": "integer"
        },
        "planners": {
          "type": "integer"
        },
        "per_role": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "max_goals_building": {
          "type": "integer"
        }
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "pre_review": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "post_merge": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "github",
            "local"
          ]
        },
        "base_branch": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        }
      }
    },
    "reviews": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "lean",
            "thorough"
          ]
        }
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "orphan_after_s": {
          "type": "integer"
        }
      }
    },
    "cadence": {
      "type": "object",
      "properties": {
        "active_s": {
          "type": "integer"
        },
        "waiting_s": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "paused_s": {
          "type": "integer"
        },
        "inbox_s": {
          "type": "integer"
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "min_interval_s": {
          "type": "integer"
        },
        "full_every_ticks": {
          "type": "integer"
        }
      }
    },
    "tracker": {
      "type": "object",
      "description": "Open object until M5: provider, mode, scope, goal_mapping, labels, status (awaiting_sync_release | pending_credentials | ready).",
      "properties": {
        "provider": {
          "type": "string"
        },
        "goal_mapping": {
          "enum": [
            "parent_issue",
            "project"
          ],
          "description": "Linear: a goal is a parent issue (default) or a project (§21.3.2)."
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "desktop": {
          "type": "boolean"
        }
      }
    },
    "control_center": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer"
        },
        "open_browser": {
          "type": "boolean"
        },
        "show_cost": {
          "type": "boolean"
        }
      }
    },
    "worktree": {
      "type": "object",
      "properties": {
        "include_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "description": "Workspace mode: one factory drives several git repos in a plain folder (contracts §20).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "default_repo": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "repos": {
      "type": "object",
      "description": "Workspace repos by name. Used only when workspace.enabled is true.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative to the workspace root, or absolute. Default: the repo name."
          },
          "default_branch": {
            "type": "string"
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "object",
            "properties": {
              "install": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "build": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "test": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "typecheck": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "run": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "e2e": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "migrate_up": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "migrate_down": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "screenshot": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "extra": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "checks": {
            "type": "object",
            "properties": {
              "pre_review": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Default: [build, lint, test] minus nulls."
              },
              "post_merge": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "delivery": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "github",
                  "local"
                ]
              },
              "base_branch": {
                "type": "string"
              },
              "remote": {
                "type": "string"
              }
            }
          },
          "remote": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              }
            }
          },
          "include_files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Default: worktree.include_files."
          }
        },
        "additionalProperties": true
      }
    },
    "teams": {
      "type": "object",
      "description": "Teams by id (§21.2). Empty: one implicit team core with every repo.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 30
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "product",
              "engineering",
              "support",
              "other"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tracker": {
            "type": "object",
            "properties": {
              "team_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "team_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "streams": {
      "type": "object",
      "description": "Bug and tech-debt work streams (§21.4). Off by default.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Empty: every team with repos."
        },
        "capacity_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "budget_tokens_per_window": {
          "type": "number"
        },
        "epic_review": {
          "type": "boolean",
          "description": "Run review_epic on stream epics (default false)."
        },
        "pull": {
          "enum": [
            "intake_label",
            "cycle",
            "all"
          ]
        },
        "classes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "cycles": {
      "type": "object",
      "description": "Cycles (§21.6). Off by default.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "tracker",
            "local",
            null
          ],
          "description": "Default: tracker when the provider is linear, else local."
        },
        "length_days": {
          "type": "integer",
          "minimum": 1
        },
        "anchor": {
          "type": "string",
          "format": "date"
        },
        "plan_at_start": {
          "type": "boolean"
        },
        "review_at_end": {
          "type": "boolean"
        }
      }
    },
    "reports": {
      "type": "object",
      "description": "CTO reports (§21.7). On by default.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "every_h": {
          "type": "number"
        },
        "idle_min_h": {
          "type": "number"
        },
        "idle_min_events": {
          "type": "number"
        },
        "max_proposals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "baseline": {
      "type": "object",
      "description": "Baseline of repos and work in flight (§21.5). On by default.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collect_every_s": {
          "type": "number"
        },
        "assess_every_h": {
          "type": "number"
        }
      }
    },
    "ops": {
      "type": "object",
      "description": "The ops goal (§21.1.2).",
      "properties": {
        "budget_tokens_per_day": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": true
}
