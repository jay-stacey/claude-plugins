{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.local/schemas/run.schema.json",
  "title": "Run",
  "description": "runs/R-000001/run.json (contracts 3).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "factory/run@1"
    },
    "id": {
      "type": "string"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "epic_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "author",
        "review",
        "qa",
        "fixup",
        "integrate",
        "escalation"
      ]
    },
    "role": {
      "enum": [
        "cto",
        "product-manager",
        "project-manager",
        "staff-engineer",
        "ui-ux-designer",
        "data-engineer",
        "backend-engineer",
        "frontend-engineer",
        "devops-release",
        "qa-engineer",
        "code-reviewer",
        "security-reviewer",
        "critic",
        "tech-writer"
      ]
    },
    "subagent_type": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "status": {
      "enum": [
        "dispatching",
        "running",
        "suspect",
        "completed",
        "failed",
        "deferred",
        "orphaned",
        "stopped"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_use_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "dispatched_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "isolation": {
      "enum": [
        "worktree",
        "none"
      ]
    },
    "worktree_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "brief_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "handoff_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "estimate_tokens": {
      "type": "number"
    },
    "round": {
      "type": "integer"
    },
    "review_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "relative to the factory home"
    },
    "exit": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "collected_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "rev",
    "task_id",
    "goal_id",
    "kind",
    "role",
    "subagent_type",
    "model",
    "status"
  ],
  "additionalProperties": true
}
